# Valores por defecto de `npm run dev`. No hay secretos aquí: se versiona a propósito para que un
# checkout limpio arranque sin configurar nada.

# Vacía = mismo origen. En desarrollo lo resuelve el proxy de `vite.config.ts`; en producción, el
# gateway. Cambiarla solo tiene sentido para apuntar a un backend remoto.
VITE_API_URL=

# El entorno de desarrollo es `tilt up` y los endpoints de v0.3 ya están en `ukun-api`, así que se
# desarrolla contra datos reales. Ponlo a `true` para trabajar contra los mocks de `src/mocks/`
# —útil si el stack no está levantado o para reproducir un caso concreto—; los tests usan MSW
# siempre, independientemente de esta variable.
VITE_ENABLE_MSW=false

# Destino del proxy. Por defecto `http://localhost:8081`; súbelo por `API_PORT` o por
# `API_PROXY_TARGET` si trabajas en un worktree con los puertos desplazados.
#API_PROXY_TARGET=http://localhost:8081
