# Plantilla versionada de la configuración del frontend. Copiar a `.env.local` para sobrescribir
# algo en una máquina concreta; los valores de desarrollo por defecto están en `.env.development`.

# Origen del API. Vacío = mismo origen, que es lo que sirve el gateway (ADR-0003).
VITE_API_URL=

# Con `true` responden los mocks de MSW (`src/mocks/`); con cualquier otro valor, el API real.
# Es la única diferencia entre desarrollar contra mocks y contra el backend.
VITE_ENABLE_MSW=false

# Destino del proxy de desarrollo para `/api` y `/media`. Por defecto `http://localhost:8081`
# (`API_PORT`); en un worktree con puertos desplazados, apúntalo al que toque.
#API_PROXY_TARGET=http://localhost:8081
