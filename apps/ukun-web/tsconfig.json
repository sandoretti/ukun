{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    /* ES2023 por Intl.NumberFormat V3: formatea el string decimal de `Money` sin pasar por double. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* El smoke de Playwright es su propio proyecto: corre en Node, no entra en el bundle, y aun así
     tiene que compilar en cada `tsc -b` como todo lo demás. */
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.e2e.json" }]
}
