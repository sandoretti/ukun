POSTGRES_USER=ukun
POSTGRES_PASSWORD=changeme
# The database ukun-api owns. Named ukun_app in docs/06-entorno-local-tilt.md and in
# docs/10-modelo-de-datos.md §8; ukun_auth is created alongside it by
# scripts/postgres-init-databases.sh. Changing this value requires a db-reset (docs/06):
# Postgres only creates POSTGRES_DB on a virgin volume.
POSTGRES_DB=ukun_app
