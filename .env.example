POSTGRES_USER=ukun
POSTGRES_PASSWORD=changeme
# The database ukun-api owns. Named ukun_app in docs/06-entorno-local-tilt.md and in
# docs/10-modelo-de-datos.md §8; ukun_auth is created alongside it by
# scripts/postgres-init-databases.sh. Changing this value requires a db-reset (docs/06):
# Postgres only creates POSTGRES_DB on a virgin volume.
POSTGRES_DB=ukun_app

# The two OAuth2 client secrets ukun-auth registers on startup (docs/08-identidad-y-seguridad.md §3
# and §4). They are secrets, so they live here and never in application.yaml or in a Liquibase
# changeset — and ukun-auth has no default for either: a service that starts with a well-known
# client secret is worse than one that refuses to start.
#
# Both have two readers, and in both cases the two must match. UKUN_OAUTH2_API_SECRET: ukun-auth
# registers the client with it, and ukun-api presents it to get the token AccountsPort calls
# /internal/accounts with. UKUN_OAUTH2_GATEWAY_SECRET: same pairing one hop over, ukun-auth registers
# it and ukun-gateway presents it at the token endpoint when exchanging the authorization code
# (issue #28) — a mismatch there surfaces as invalid_client at the end of the login, not at startup.
#
# For a local checkout any two values will do; generate them rather than typing something memorable:
#   openssl rand -hex 32
UKUN_OAUTH2_GATEWAY_SECRET=changeme-gateway
UKUN_OAUTH2_API_SECRET=changeme-api

# The `iss` claim of every token, and the base of the OIDC discovery document. Only set these if the
# stack is not reachable at the default ports — compose derives them from AUTH_PORT/GATEWAY_PORT.
# Both ukun-api (issue #24) and the gateway (issue #28) compare against this exact string, so a value
# that is right for one and wrong for the other fails at token validation, not here.
#
# UKUN_AUTH_ISSUER is also what the BROWSER follows: the gateway derives the authorization endpoint
# it redirects to from it, so it has to be reachable from the host and not from the Docker network.
# Its container-facing counterparts are UKUN_AUTH_TOKEN_URI and UKUN_AUTH_JWK_SET_URI, which compose
# sets by container name. UKUN_GATEWAY_BASE_URL has to match the redirect and post-logout URIs
# ukun-auth registered, trailing slash included on the second one.
# UKUN_AUTH_ISSUER=http://localhost:9000
# UKUN_GATEWAY_BASE_URL=http://localhost:8080

# Host ports are not set here. compose.yaml and compose.dev.yaml default to the base ports
# (8081, 9000, 8080, 5173, 5432, 5005-5007), which is what a single checkout wants.
#
# To run a second stack alongside this one, the `worktree` skill writes a separate .env.ports
# in each worktree with COMPOSE_PROJECT_NAME and a +100 offset per worktree — do not add those
# variables here by hand. See docs/06-entorno-local-tilt.md, "Varios worktrees a la vez".

# El destino OTLP (issue #52, docs/11-observabilidad-y-logging.md §5). No hace falta tocarlas: el
# colector del entorno local lo levanta compose.dev.yaml y es él quien las pone, apuntando al nombre
# del contenedor. Están aquí para que se sepa que existen y para apuntar a otro colector sin editar
# el compose — por ejemplo uno arrancado a mano, o el de un worktree con los puertos desplazados.
#
# Su ausencia es la configuración por defecto: sin ellas no se instala exportador y los tres servicios
# arrancan igual. En producción salen del despliegue (ADR-0023), no de este fichero.
# MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# MANAGEMENT_OTLP_METRICS_EXPORT_URL=http://localhost:4318/v1/metrics
# MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=true

# El puerto del colector en el host. Solo se toca para un segundo stack: la skill `worktree` desplaza
# +100 por worktree igual que con los demás.
# OTLP_PORT=4318
