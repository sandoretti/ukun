# Imagen de DESARROLLO para Tilt. No usar en producción — ver docs/06-entorno-local-tilt.md.
#
# A diferencia del Dockerfile de producción (que empaqueta un jar), esta imagen espera
# encontrar las clases ya compiladas en target/classes y las dependencias en
# target/dependency (las genera el local_resource "mvn-empleados" del Tiltfile antes de
# que esta imagen se construya). Eso es lo que permite que Tilt sincronice solo el
# classpath y reinicie el proceso (restart_container()) sin reconstruir la imagen.
FROM eclipse-temurin:17-jre-jammy
WORKDIR /opt/app

RUN mkdir -p /opt/app/classes /opt/app/deps
COPY target/dependency/ /opt/app/deps/
COPY target/classes/    /opt/app/classes/

EXPOSE 8082 5005
ENV JAVA_TOOL_OPTIONS="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"

ENTRYPOINT ["java", "-cp", "/opt/app/classes:/opt/app/deps/*", "dev.sandoretti.ukun.empleados.app.UkunEmpleadosApplication"]
