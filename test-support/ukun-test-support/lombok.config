# Same policy as services/lombok.config, and it has to be repeated here rather than shared.
#
# Lombok reads its configuration by bubbling up from the directory of the source file, and
# services/lombok.config declares `config.stopBubbling = true`, which scopes it to services/ and
# nothing else. That same boundary means it does not reach test-support/ either.
#
# Without addLombokGeneratedAnnotation the fixture violations/LombokEntity compiles into a class
# file with no trace of @Data at all (SOURCE retention), ENTITIES_WRITE_THEIR_OWN_IDENTITY finds
# nothing to complain about, and the self-test that exists to prove the rule works fails instead —
# loudly, which is the one saving grace of this duplication.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
