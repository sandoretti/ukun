<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator POM for the new Ukun services (ADR-0001).

  This is the single place where the version of Spring Boot, Spring Cloud, Java and every
  build plugin is decided. The three modules below inherit all of it and MUST NOT declare a
  <version> for anything managed here.

  Deliberately NOT a child of spring-boot-starter-parent: ADR-0001 requires both platform
  BOMs to be *imported* into <dependencyManagement>, never inherited as a <parent>. The cost
  is that everything spring-boot-starter-parent would provide for free (compiler config, the
  repackage execution, surefire/failsafe wiring) is declared explicitly below — which is the
  point: it is visible and it is in one file.

  The legacy monoliths (ukun-clientes, ukun-empleados) are NOT modules of this reactor. They
  are on Boot 3.2.3 / Java 17 and are deleted in v0.6/v0.7 — see docs/04-roadmap.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.sandoretti.ukun</groupId>
    <artifactId>ukun-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ukun-parent</name>
    <description>Aggregator and dependency/plugin management for the Ukun services</description>

    <modules>
        <module>services/ukun-api</module>
        <module>services/ukun-auth</module>
        <module>services/ukun-gateway</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Platform versions. See docs/05-stack-y-versiones.md; re-verified against Maven
             Central on 2026-08-07 before being pinned here, as that document requires. -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>

        <!-- An imported BOM contributes dependency versions but NOT its properties, so
             ${lombok.version} has to be spelled out here to be usable in
             annotationProcessorPaths below. Keep it in sync with what
             spring-boot-dependencies:${spring-boot.version} manages. -->
        <lombok.version>1.18.46</lombok.version>

        <!-- Not covered by either platform BOM. -->
        <spring-modulith.version>2.1.0</spring-modulith.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>3.0.3</springdoc.version>
        <!-- Verified against Maven Central on 2026-08-08, as docs/05-stack-y-versiones.md
             requires. 1.5.0 reads up to class file major version 71 (Java 27), well past the
             69 this build emits. -->
        <archunit.version>1.5.0</archunit.version>

        <!-- Build plugins. Nothing manages these for us without a parent. -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Used from v0.2 onwards (ADR-0017, docs/14-modules.md); managed here so the
                 modules only ever add the <dependency>, never a <version>. -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- The seven hard rules of docs/03-analisis-y-patrones.md §3. The plain `archunit`
                 artifact, not `archunit-junit5`: the rules are checked from ordinary JUnit 5
                 tests with AssertJ, which is what the `testing` skill mandates — the @ArchTest
                 engine would sidestep that convention. -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- Every module produces target/app.jar. This is what makes the fixed-name
             ENTRYPOINT in the production Dockerfiles possible, and it is the root fix for
             legacy defect #16 (docs/03-analisis-y-patrones.md §1): the legacy images use
             `java -jar /opt/app/*.jar` in exec form, which never expands the glob. -->
        <finalName>app</finalName>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                    <!-- Order matters and is not interchangeable: Lombok must run first, or
                         MapStruct reads the entity before the getters/setters exist and
                         generates an empty mapper. The binding artifact is what makes the two
                         processors cooperate. See docs/05-stack-y-versiones.md, MapStruct row.
                         This one list feeds both `compile` and `testCompile`; there is no
                         `testAnnotationProcessorPaths` parameter on this plugin. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                        <!-- Without this, a mapper that declares `uses = …` gets its collaborators
                             through @Autowired fields. Constructor injection is what the skill
                             `java-springboot` asks for and what makes the generated mapper testable
                             with a plain `new`; it also keeps the collaborator final. -->
                        <arg>-Amapstruct.defaultInjectionStrategy=constructor</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- *Test -> surefire (unit), *IT -> failsafe (integration, Testcontainers).
                 They must not overlap: skill `testing`. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- Without this, failsafe runs against the artifact left by
                         spring-boot:repackage — a fat jar whose classes live under
                         BOOT-INF/classes, where component scanning cannot find the
                         @SpringBootApplication. Point it at the plain output directory instead. -->
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Informative only. No global coverage threshold: the mandatory ones land on
                 `orders` and `inventory` when those modules exist (skill `testing`). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
