# Secretos locales — ver .env.example para la plantilla versionada.
.env
.env.*
!.env.example

# Gradle (los tres servicios nuevos). El wrapper sí se versiona, igual que se versionaba el de Maven.
build/
.gradle/

# Maven: solo lo usa ya ukun-empleados, que lo lista también en su propio .gitignore. Esta línea se
# va con él en v0.7.
target/

# Node / frontend
node_modules/
dist/

# Playwright: el informe y las trazas del smoke son de una ejecución, no del repo. Los navegadores
# viven en ~/.cache/ms-playwright y no aquí.
test-results/
playwright-report/
blob-report/

# IDE
.idea/
*.iml
.vscode/

# Claude Code: las skills y CLAUDE.md sí se versionan; los ajustes locales no
.claude/settings.local.json

# Estado local de cada worktree (skill `worktree`): el encargo de la slice y los
# scripts de arranque de sus pestañas de Konsole. Se regeneran, no se comparten.
.claude/ENCARGO.md
.claude/session/

# Tilt
tilt_modules/
.tilt-gradle.lock
