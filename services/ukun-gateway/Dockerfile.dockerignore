# Ignore list for services/ukun-gateway/Dockerfile. BuildKit reads <dockerfile>.dockerignore in
# preference to a .dockerignore at the context root, which is how each service keeps its own
# list even though they all share the repository root as build context.

# Build output — the image compiles from source, it never copies a locally built jar. `**/build/`
# only matches directories named exactly `build`, so neither buildSrc/ nor any build.gradle.kts is
# caught by it.
**/build/
.gradle/

# Git metadata. In a worktree .git is a file, not a directory; both patterns are covered.
.git
.git/
.gitignore
.gitattributes

# Secrets. .env.example is the versioned template and is not needed in the image either.
.env
.env.*

# Everything outside the new services.
ukun-empleados/
nginx/
database/
resources/
scripts/
docs/
apps/
.claude/
tilt_modules/
Tiltfile
compose*.yaml
docker-compose*.yml
*.md

# The other projects' sources. Their build scripts are still needed to configure the build and are
# copied explicitly by the Dockerfile, so only src/ is excluded here. :ukun-test-support carries the
# shared ArchUnit rules and is never on a runtime classpath, so none of its sources belong in any
# image either.
services/ukun-api/src/
services/ukun-auth/src/
test-support/ukun-test-support/src/

# Frontend and IDE noise.
node_modules/
dist/
.idea/
.vscode/
*.iml
