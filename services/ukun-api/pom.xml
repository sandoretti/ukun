<?xml version="1.0" encoding="UTF-8"?>
<!--
  Domain API monolith. As of v0.2 (docs/04-roadmap.md) this carries the ten Spring Modulith
  application modules of ADR-0017 §1, declared empty, plus the ModulithTest that verifies their
  dependency graph on every build. Business code lands from v0.3 onwards.

  No <version> is declared for any dependency or plugin: everything comes from ../../pom.xml.
  No JPA and no Security yet — the Liquibase baseline of ukun_app is a separate slice; without a
  datasource the context would not start, and an unconfigured Security would stop
  /actuator/health from answering 200.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.sandoretti.ukun</groupId>
        <artifactId>ukun-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ukun-api</artifactId>
    <name>ukun-api</name>
    <description>Ukun domain API</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Swagger UI for manual exploration only. The versioned contract in
             docs/api/openapi/ is the source of truth, not this (docs/06-entorno-local-tilt.md). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Application modules (ADR-0017, docs/14-modules.md). Versions come from the
             spring-modulith-bom imported in ../../pom.xml — never declare one here.
             starter-core carries the @ApplicationModule annotation; the actuator serves
             /actuator/modulith, exposed only under the dev profile (docs/14 §6). -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-actuator</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 split the test starters: TestRestTemplate is gone from
             spring-boot-starter-test and RestTestClient is the replacement, in its own module. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ApplicationModules.verify() and the Documenter that replaces a hand-drawn package
             diagram in docs/01-arquitectura.md. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-docs</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
